NVD_API_KEY=
SHODAN_API_KEY=
ALERT_WEBHOOK_URL=
# --- LLM narrative + AI correlation (optional; Kilo Gateway, OpenAI-compatible) ---
# Only LLM_API_KEY is required: a Kilo Gateway API key (JWT) from your own Kilo account. RiskPatch ships no key.
# POST {LLM_BASE_URL}/chat/completions with "Authorization: Bearer <LLM_API_KEY>". GET {LLM_BASE_URL}/models needs no key.
LLM_API_KEY=
#LLM_BASE_URL=https://ai-gateway.kilo.ai/api/v1
#LLM_MODEL=kilo-auto/free
# Optional x-kilocode-mode header (e.g. code, ask); empty = not sent
#LLM_KILO_MODE=
#LLM_CHAT_PATH=/chat/completions
#LLM_TIMEOUT_SECONDS=60
#LLM_MAX_TOKENS=1500
#LLM_AUTH_HEADER=Authorization
#LLM_AUTH_SCHEME=Bearer
POLL_INTERVAL_SECONDS=21600
CACHE_TTL_HOURS=6
RISKPATCH_OFFLINE=0
RISKPATCH_INVENTORY=/data/inventory/stack.yaml
RISKPATCH_REPORTS=/data/reports
RISKPATCH_CACHE=/data/cache

# --- RiskPatch server (Phase 1) ---
# Creates an admin token on first start; then create scoped tokens with `riskpatch token create` and remove this.
# First web UI admin account (created only when no admin exists yet). Password: at least 12 characters.
RISKPATCH_BOOTSTRAP_ADMIN_USER=
RISKPATCH_BOOTSTRAP_ADMIN_PASSWORD=
RISKPATCH_BOOTSTRAP_TOKEN=
RISKPATCH_COOKIE_SECURE=1
CVE_SYNC_INTERVAL_SECONDS=3600
ANALYSIS_INTERVAL_SECONDS=10800
RAW_RETENTION_DAYS=90
RISKPATCH_PACKAGE_WATCH=
